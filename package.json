{
  "name": "researchbot-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @researchbot/web dev",
    "dev:server": "pnpm --filter @researchbot/server dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @researchbot/web build",
    "build:server": "pnpm --filter @researchbot/server build",
    "build:shared": "pnpm --filter @researchbot/shared build",
    "build:tools": "pnpm --filter @researchbot/langchain-tools build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}