{
  "name": "@researchbot/langchain-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./search": {
      "import": "./dist/tools/search.js",
      "types": "./dist/tools/search.d.ts"
    },
    "./registry": {
      "import": "./dist/registry/index.js",
      "types": "./dist/registry/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@researchbot/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}